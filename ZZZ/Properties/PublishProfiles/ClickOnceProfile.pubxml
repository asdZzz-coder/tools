<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce 發布設定:單一執行檔、framework-dependent(不含 .NET 執行環境)。
  需要 Visual Studio 2026 的 MSBuild(dotnet publish 不支援 ClickOnce):
    msbuild ZZZ\ZZZ.csproj /t:Publish /p:PublishProfile=ClickOnceProfile /p:Configuration=Release
  產出位置:ZZZ\bin\Release\net10.0-windows\win-x64\app.publish\(Ledger.application、Application Files\;壓縮包另加 installer\安裝.cmd)
  版本號由 CI 以 /p:Version 與 /p:ApplicationVersion 依 git 標籤覆寫。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>

    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>bin\Release\net10.0-windows\win-x64\app.publish\</PublishDir>
    <InstallFrom>Disk</InstallFrom>
    <Install>true</Install>
    <GenerateManifests>true</GenerateManifests>
    <!-- 跟著 csproj 的 Version(CI 以標籤覆寫 Version 與 ApplicationVersion);版本不同,ClickOnce 才會把它當成新版 -->
    <ApplicationVersion>$(Version).0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <IsRevisionIncremented>false</IsRevisionIncremented>

    <!-- 安裝包放在 GitHub Release,無法提供固定的更新網址;改由程式內的「檢查更新」提示新版 -->
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>

    <!-- 不產生 setup.exe:改由 installer\安裝.cmd 先複製到固定資料夾再開啟 Ledger.application,避免「已從其他位置安裝」的錯誤 -->
    <BootstrapperEnabled>false</BootstrapperEnabled>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <OpenBrowserOnPublish>false</OpenBrowserOnPublish>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>

    <ProductName>簡易記帳</ProductName>
    <PublisherName>asdZzz-coder</PublisherName>
    <SuiteName>簡易記帳</SuiteName>

    <SignManifests>false</SignManifests>
    <SignatureAlgorithm>(None)</SignatureAlgorithm>
    <SkipPublishVerification>false</SkipPublishVerification>
  </PropertyGroup>
</Project>
