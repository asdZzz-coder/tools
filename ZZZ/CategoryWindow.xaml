<Window x:Class="ZZZ.CategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理分類" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate x:Key="CatItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="Del" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;"
                        Width="30" Height="30" FontSize="12" ToolTip="刪除" Visibility="Hidden"
                        Click="OnDelete" Tag="{Binding}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Del" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="CatItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource SoftItem}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="12,0,4,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="16">
            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22"/></Border.Effect>
        </Border>
        <Border Background="{DynamicResource BgBrush}" CornerRadius="16" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" Padding="22,18,22,22">
            <StackPanel>
                <Grid Margin="0,0,0,16" Background="Transparent" MouseLeftButtonDown="OnDrag">
                    <StackPanel>
                        <TextBlock Text="管理分類" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="刪除分類不會影響已存在的記錄" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Width="32" Height="32" IsCancel="True" Click="OnClose"/>
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <!-- 支出 -->
                    <Border Style="{StaticResource Card}" Width="260" Padding="14" Margin="0,0,14,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource ExpBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="支出分類" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="ExpList" Style="{StaticResource PlainList}" Height="300"
                                     ItemTemplate="{StaticResource CatItem}" ItemContainerStyle="{StaticResource CatItemStyle}" Tag="支出"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExpBox" Tag="新分類名稱" KeyDown="OnBoxKey"/>
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="12,0"
                                        Click="OnAdd" Tag="支出">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- 收入 -->
                    <Border Style="{StaticResource Card}" Width="260" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource IncBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="收入分類" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="IncList" Style="{StaticResource PlainList}" Height="300"
                                     ItemTemplate="{StaticResource CatItem}" ItemContainerStyle="{StaticResource CatItemStyle}" Tag="收入"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="IncBox" Tag="新分類名稱" KeyDown="OnBoxKey"/>
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="12,0"
                                        Click="OnAdd" Tag="收入">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
