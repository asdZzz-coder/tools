<Window x:Class="ZZZ.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <Grid Margin="24">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14">
            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22"/></Border.Effect>
        </Border>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                Padding="24,22,24,20" Width="400" MouseLeftButtonDown="OnDrag">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBg" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource GhostBrush}">
                        <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="16"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                </Grid>
                <TextBlock x:Name="MessageText" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                           TextWrapping="Wrap" LineHeight="22" Margin="0,14,0,0"/>
                <StackPanel x:Name="Fields"/>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ExpBrush}" FontSize="12"
                           Margin="2,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" Content="取消" MinWidth="88" IsCancel="True"/>
                    <Button x:Name="OkBtn" Style="{StaticResource AccentButton}" Content="確定" MinWidth="88"
                            Margin="10,0,0,0" IsDefault="True" Click="OnOk"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
