<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 淺色配色。鍵值要與 Colors.Dark.xaml 一一對應;介面一律用 DynamicResource 引用,切換時才會即時換色 -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="InkHoverBrush" Color="#374151"/>
    <SolidColorBrush x:Key="OnInkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#CDD1D7"/>
    <SolidColorBrush x:Key="RowLineBrush" Color="#F0F1F3"/>
    <SolidColorBrush x:Key="SelBrush" Color="#EDF1F7"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="GhostBrush" Color="#EEF0F3"/>
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#E2E5E9"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="IncBrush" Color="#0E9F6E"/>
    <SolidColorBrush x:Key="IncSoftBrush" Color="#E6F6EF"/>
    <SolidColorBrush x:Key="ExpBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="ExpSoftBrush" Color="#FDECEC"/>
    <SolidColorBrush x:Key="ExpSoftHoverBrush" Color="#FAD7D7"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#EA580C"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FFF1E6"/>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2B3545" Offset="0"/>
        <GradientStop Color="#111827" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
